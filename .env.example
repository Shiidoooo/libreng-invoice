# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Both values are public by design (they ship in the browser bundle); Row Level
# Security in the database protects the data. Never put the secret/service_role
# key or the database password here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
